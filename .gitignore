# Installer, portable exe and unpacked app made by "Build installer.cmd" (each over 100 MB).
# Build them again any time; attach the Setup .exe to a GitHub Release instead of committing it.
dist/

# Downloaded by "npm install" / "Start ArchipelagoVic.cmd" (Electron alone is about 250 MB).
node_modules/

# Windows / macOS / editor clutter
Thumbs.db
desktop.ini
.DS_Store
*.log

# Game ROMs must never be committed (they are copyrighted and belong to you only).
ROM/
*.gb
*.gbc
*.gba
*.sfc
*.smc
*.nes
*.z64
*.n64
*.iso
*.bin

# Archipelago patch files (.apred, .apblue, ...) and generated games.
# Patched ROMs use the ROM extensions above. Apworlds (.apworld) are code, so keep them.
*.ap*
!*.apworld
AP_*.zip
