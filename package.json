{
  "name": "archipelagovic",
  "productName": "ArchipelagoVic",
  "version": "2.6.2",
  "description": "Archipelago launcher and text client in one window",
  "main": "main.js",
  "author": "Vic",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "standalone": "node tools/build-standalone.js",
    "dist": "npx --yes electron-builder@26.15.3 --win nsis portable"
  },
  "devDependencies": {
    "electron": "44.4.5"
  },
  "build": {
    "appId": "com.vic.archipelagovic",
    "productName": "ArchipelagoVic",
    "files": [
      "main.js",
      "preload.js",
      "aplib.js",
      "components.json",
      "game-art.json",
      "renderer/**/*",
      "logic/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "renderer/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ArchipelagoVic",
      "installerIcon": "renderer/icon.ico",
      "uninstallerIcon": "renderer/icon.ico"
    },
    "portable": {
      "artifactName": "ArchipelagoVic-${version}-portable.exe"
    }
  }
}
